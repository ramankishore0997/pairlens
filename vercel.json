{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS=1 bun run build",
  "outputDirectory": "apps/terminal/dist/client",
  "build": {
    "env": {
      "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
    }
  },
  "env": {
    "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/_shell.html"
    }
  ]
}
